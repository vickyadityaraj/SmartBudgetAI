# =========================================================================
# Smart Budget Genius - Backend Environment Variables Template
# =========================================================================
# Copy this file to a new file named '.env' in this directory and
# replace the placeholder values with your actual credentials.
#
# DO NOT commit the '.env' file to Git or push it to GitHub.
# =========================================================================

# MongoDB Connection URI
MONGODB_URI=mongodb://127.0.0.1:27017/smartbudget

# Port for the backend Express server
PORT=5000

# Secret key for JWT token signing and authentication
JWT_SECRET=your_jwt_secret_key_here

# Node environment (development, production)
NODE_ENV=development

# AI Financial Advisor Service Keys (Optional)
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=sk-your_openai_api_key_here

