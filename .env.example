# =========================================================================
# Smart Budget Genius - Root Environment Variables Template
# =========================================================================
# Copy this file to a new file named '.env' in the same directory and
# replace the placeholder values with your actual credentials.
#
# DO NOT commit the '.env' file to Git or push it to GitHub.
# =========================================================================

# MongoDB Connection URI
# - For local database: mongodb://127.0.0.1:27017/smartbudget
# - For cloud database: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/smartbudget?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/smartbudget

# Server & Environment Configuration
PORT=5000
NODE_ENV=development

# Secret key for JWT token signing and authentication (use a long, random string)
JWT_SECRET=your_jwt_secret_key_here

# API URL for the frontend Vite application to communicate with the backend
VITE_API_URL=http://localhost:5000/api

# AI Financial Advisor Service Keys (Optional)
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=sk-your_openai_api_key_here

